require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

prepare_react_native_project!

target 'signal-app-macOS' do
  platform :macos, '26.0'
  use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()

  pod 'Sparkle', '~> 2.7'

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)
    patch_fmt_consteval(installer)
  end
end

# fmt 11.0.2 is pinned by RCT-Folly and uses consteval format-string checks that
# Apple clang from Xcode 26.6+ rejects ("call to consteval function ... is not a
# constant expression"). Upstream fixed this in fmt 11.1, which we can't move to
# while Folly pins the version, so force the non-consteval code path instead.
def patch_fmt_consteval(installer)
  base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
  return unless File.exist?(base_h)

  guard = "#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n"
  source = File.read(base_h)
  return if source.include?(guard)

  anchor = "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
  unless source.include?(anchor)
    Pod::UI.warn 'fmt/base.h layout changed; skipping consteval patch'
    return
  end

  # Pod sources land read-only, and CocoaPods may hard-link them from its cache,
  # so replace the file rather than writing through to a shared inode.
  mode = File.stat(base_h).mode & 0o7777
  patched = source.sub(anchor, guard + anchor)
  File.delete(base_h)
  File.write(base_h, patched)
  File.chmod(mode, base_h)
  Pod::UI.puts 'Patched fmt/base.h to disable consteval format-string checks'
end
