{
  "name": "signal-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "macos": "react-native run-macos",
    "macos:dev": "npm run start & sleep 5 && open macos/build/Build/Products/Debug/signal-app.app",
    "macos:fresh": "rm -rf \"$HOME/Library/Application Support/hush\" && npm run macos:dev",
    "lint": "eslint .",
    "postinstall": "npx patch-package"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "19.1.4",
    "react-native": "0.81.5",
    "react-native-macos": "0.81.1",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-svg": "^15.11.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/cli": "^20.1.1",
    "@react-native-community/cli-platform-ios": "^20.1.1",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@types/react": "^19.1.4",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
