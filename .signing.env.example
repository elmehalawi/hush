# Copy to .signing.env and fill in. .signing.env is gitignored: keep the
# certificate and notarization credentials out of this public repo.
#
# SIGN_IDENTITY must name a Developer ID Application certificate in the login
# keychain. Only the Account Holder can create one -- Xcode > Settings >
# Accounts > Manage Certificates > + > Developer ID Application. List them with:
#     security find-identity -v -p codesigning
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization: either an App Store Connect API key (preferred -- no keychain
# round-trip, so it works in non-interactive shells) ...
NOTARY_KEY="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
NOTARY_KEY_ID="XXXXXXXXXX"
NOTARY_ISSUER="00000000-0000-0000-0000-000000000000"

# ... or a keychain profile stored once with:
#     xcrun notarytool store-credentials <name> --key <p8> --key-id <id> --issuer <issuer>
# NOTARY_PROFILE="hush-notary"

# Optional: a dedicated keychain holding the identity. Recommended -- it lets
# set-key-partition-list authorize codesign without the login keychain password,
# so signing works in non-interactive shells.
# SIGN_KEYCHAIN="$HOME/Library/Keychains/hush-signing.keychain-db"
# SIGN_KEYCHAIN_PASSWORD="..."
